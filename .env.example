# InvoiceGuard AI — environment configuration example
# Copy to .env (NEXT TO the backend directory you run uvicorn from) and edit.
# Every variable below is optional; defaults are shown.

# Daily successful validations per anonymous session
INVOICEGUARD_DAILY_LIMIT=10

# Calendar used for the daily reset (server-computed, never client-trusted)
INVOICEGUARD_TIMEZONE_NAME=Asia/Kolkata

# SQLite database file
INVOICEGUARD_DB_PATH=data/invoiceguard.db

# Upload guardrails
INVOICEGUARD_MAX_UPLOAD_BYTES=10485760

# Currency assumed when NEITHER document states one
INVOICEGUARD_DEFAULT_CURRENCY=INR

# Matching thresholds
INVOICEGUARD_FUZZY_THRESHOLD=85.0
INVOICEGUARD_SEMANTIC_THRESHOLD=0.72
INVOICEGUARD_AMBIGUOUS_SCORE_GAP=0.05
INVOICEGUARD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Financial tolerances
INVOICEGUARD_PRICE_TOLERANCE_PCT=0.005
INVOICEGUARD_ABSOLUTE_PRICE_TOLERANCE=0.01
INVOICEGUARD_QUANTITY_TOLERANCE=0.0001
INVOICEGUARD_SHORTFALL_AS_DISCREPANCY=false
